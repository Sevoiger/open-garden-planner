# Testing
.pytest_cache/
.coverage
# Generated by scripts/measure_array_tool_coverage.py; embeds absolute
# source paths and is rewritten on every run, so it must not be tracked.
coverage-report.json
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/

# Distribution
*.exe
*.msi

# Project specific
*.ogp.backup
# Auto-save files are written NEXT TO the project file (`AutosaveService`
# names them `~autosave_<name>.ogp`), so opening any tracked plan creates one
# beside it. The `*~` rule above does not cover them — the tilde is a prefix
# here, not a suffix — and a `git add -A` in a docs/ or tests/fixtures/ tree
# sweeps one in. That happened once already, in the task-date-correctness PR.
~autosave_*.ogp
competitor_screenshots/
# Smoke-test export artifacts (PDFs at repo root from validate_exports.py)
/*.pdf

# Qt Quick 3D spike measurement output (--spike-q3d --out DIR)
/spike-*/

# API keys and secrets
.env
.env.local
api_keys.json

# Code statistics
.VSCodeCounter/

# Lock created by scripts/verify_lod_removal_mutations.py while it rewrites
# live canvas source files; never belongs in the tree.
scripts/.verify_lod_removal_mutations.lock

# Personal macOS fork: local tools, private garden documents and logs
.tools/
.local/
sources-jardin/
jardin-personnel/
.DS_Store
# Owner's local mandate contains personal garden context
MISSION_AGENT_JARDIN.md
# Imported project attachments are private runtime data
*.assets/

# Owner-provided local UI captures
/toPatch/
/topatch/

# Owner-provided plant imports and generated local reading copies
/plants/
/output/
/tmp/pdfs/
/visuals/
# Local source location embedded by the macOS launcher build.
Jardin.app/Contents/Resources/SourceRoot.txt
